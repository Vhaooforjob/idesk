    },
    "Click to switch desktops. Shift-click to move the focused window here and follow it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm để đổi desktop. Giữ Shift rồi bấm để chuyển cửa sổ đang dùng đến đây và đi theo."

    "Import replaces settings. Match each saved desktop or skip it. Imported rules start disabled; sessions only run when you apply a preset.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập sẽ thay thế cấu hình. Ghép từng desktop đã lưu hoặc bỏ qua. Quy tắc nhập vào được tắt; phiên làm việc chỉ chạy khi bạn áp dụng preset."
          }
        }
      }
    },
    "Invalid address.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ không hợp lệ."
          }
        }
      }
    },
    "Invalid backup, unsupported version, or duplicate desktop mapping.": {
      "localizations": {

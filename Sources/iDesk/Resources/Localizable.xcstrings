      }
    },
    "Switch effect": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiệu ứng chuyển"
          }
        }
      }
    },
    "System Default": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định hệ thống"
          }
        }
      }
    },
    "The last screen on stays on.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn cuối cùng đang bật sẽ luôn được giữ bật."
          }
        }
      }
    },
    "The new language is used the next time iDesk opens.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ mới được dùng ở lần mở iDesk tiếp theo."
          }
        }
      }
    },
    "The screens go back to how they were in %lld seconds.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình sẽ trở lại như cũ sau %lld giây."
          }
        }
      }
    },
    "This version of macOS does not let iDesk turn screens off.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản macOS này không cho iDesk tắt màn hình."
          }
        }
      }
    },
    "Turn Every Screen Back On": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật lại mọi màn hình"
          }
        }
      }
    },
    "Turn Screens On or Off": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt màn hình"
          }
        }
      }
    },
    "Turn every screen back on": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật lại mọi màn hình"
          }
        }
      }
    },
    "Turn on a Mission Control shortcut": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật phím tắt Mission Control"
          }
        }
      }
    },
    "Turning a screen off asks you to keep the change, and undoes it after %lld seconds without an answer. Logging out or quitting iDesk turns every screen back on.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt một màn hình, iDesk sẽ hỏi bạn có giữ thay đổi không, và tự hoàn tác sau %lld giây nếu không trả lời. Đăng xuất hoặc thoát iDesk sẽ bật lại mọi màn hình."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tác"
          }
        }
      }
    },
    "Use Default Name": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tên mặc định"
          }
        }
      }
    },
    "Which screens are on": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình nào đang bật"
          }
        }
      }
    },
    "Windy": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gió mạnh"
          }
        }
      }
    },
    "Write shortcuts with ⌃ ⌥ ⇧ ⌘ and a key, for example ⌃⌥D.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi phím tắt bằng ⌃ ⌥ ⇧ ⌘ và một phím, ví dụ ⌃⌥D."
          }
        }
      }
    },
    "iDesk Settings": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt iDesk"
          }
        }
      }
    },
    "iDesk switches desktops with “Move left a space” and “Move right a space”, or “Switch to Desktop N”. Turn them on in System Settings → Keyboard → Keyboard Shortcuts → Mission Control.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk chuyển desktop bằng “Di chuyển sang trái một không gian”, “Di chuyển sang phải một không gian” hoặc “Chuyển sang Desktop N”. Hãy bật chúng trong Cài đặt hệ thống → Bàn phím → Phím tắt → Mission Control."
          }
        }
      }
    },
    "macOS only lets apps switch desktops by pressing the Mission Control shortcuts. Turn on iDesk under Privacy & Security → Accessibility, then click the desktop again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chỉ cho phép ứng dụng chuyển desktop bằng cách bấm phím tắt Mission Control. Hãy bật iDesk trong Quyền riêng tư & Bảo mật → Trợ năng, rồi bấm lại vào desktop."
          }
        }
      }
    },
    "macOS refused the screen change (error %lld).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS từ chối thay đổi màn hình (lỗi %lld)."
          }
        }
      }
    }
  },
  "version": "1.0"
}
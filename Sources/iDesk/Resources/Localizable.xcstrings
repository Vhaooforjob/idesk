      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép desktop"
          }
        }
      }
    },
    "Move new windows to a desktop without following them. Rules use the first matching app and title. Windows stay on the same display; full screen and minimized windows are excluded.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển cửa sổ mới đến desktop mà không đi theo. Dùng quy tắc đầu tiên khớp ứng dụng và tiêu đề. Cửa sổ chỉ chuyển trong cùng màn hình; bỏ qua cửa sổ toàn màn hình và thu nhỏ."
          }
        }
      }
    },
    "New Window Rule": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc cửa sổ mới"
          }
        }
      }
    },

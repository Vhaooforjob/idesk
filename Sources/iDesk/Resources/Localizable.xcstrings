    "Name every desktop. Names are kept by iDesk and follow each desktop even when you reorder them in Mission Control.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên cho từng desktop. iDesk lưu tên và tên đi theo desktop kể cả khi bạn sắp xếp lại trong Mission Control."
          }
        }
      }
    },
    "Needed to switch desktops: iDesk presses the Mission Control shortcuts for you.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần để chuyển desktop: iDesk bấm phím tắt Mission Control giúp bạn."
          }
        }
      }
    },
